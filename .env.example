# ==========================================
# Learn2Invest - Production Environment Guide
# ==========================================

# ------------------------------------------
# Backend Environment Variables (Set on Render)
# ------------------------------------------
# Port automatically assigned by Render (default: 5000)
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learn2invest?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# MongoDB Connection Timeout (in milliseconds, default: 15000 for production)
MONGODB_TIMEOUT_MS=15000

# Secret key for JWT authentication signing
JWT_SECRET=your_secure_random_jwt_secret_key

# Google Gemini API key for AI Chatbot
GEMINI_API_KEY=your_gemini_api_key

# Node Environment
NODE_ENV=production

# ------------------------------------------
# Frontend Environment Variables (Set on Vercel)
# ------------------------------------------
# URL of your deployed Render backend (no trailing slash)
# Example: https://learn2invest-backend.onrender.com
VITE_API_BASE_URL=https://your-backend-name.onrender.com
